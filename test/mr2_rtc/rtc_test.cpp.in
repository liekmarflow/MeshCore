#include <Arduino.h>
#include <Wire.h>
#include <I2cBusRecovery.h>
#include <Rv3028Wake.h>

#include <cassert>
#include <cstdio>

namespace {
constexpr uint8_t SDA = 13;
constexpr uint8_t SCL = 14;
constexpr uint8_t INT = 17;
constexpr uint8_t ADDRESS = 0x52;
constexpr uint8_t STATUS = 0x0e;
constexpr uint8_t CTRL1 = 0x0f;
constexpr uint8_t CTRL2 = 0x10;
constexpr uint8_t CLKOUT = 0x35;
constexpr uint8_t BACKUP = 0x37;

struct GpioMock {
  std::array<uint8_t, 64> modes{};
  std::array<uint8_t, 64> levels{};
  unsigned long micros = 0;
  unsigned clocks = 0;
  bool sclStuck = false;
  bool sdaStuck = false;
  unsigned releaseSdaAfterClocks = 0;
  bool intStuck = false;
  bool droveHigh = false;
} gpio;

void reset() {
  Wire = WireMock{};
  gpio = GpioMock{};
  gpio.levels.fill(HIGH); // stale output latches must be cleared before OUTPUT
  // Non-default settings make dropped writes observable. EERD starts clear.
  Wire.registers[CTRL1] = 0xa0;
  Wire.registers[CTRL2] = 0x61;
  Wire.registers[STATUS] = 0x09;
  Wire.registers[CLKOUT] = 0xf8;
  Wire.registers[BACKUP] = 0xff;
}

void assertBounded(size_t maximumTransfers = 250) {
  assert(Wire.endCount <= 2);
  assert(Wire.transfers.size() < maximumTransfers);
  assert(gpio.micros < 1000000);
}

bool configure() { return inhero::configurePeriodicWake(60); }

void faultEveryTransfer(bool (*operation)()) {
  reset();
  assert(operation());
  const auto sequence = Wire.transfers;
  assert(!sequence.empty());
  for (size_t index = 0; index < sequence.size(); ++index) {
    const bool isRead = sequence[index].kind == Transfer::Read;
    for (bool persistent : {false, true}) {
      reset();
      Wire.fault = isRead ? WireMock::ShortRead : WireMock::Nack;
      Wire.failAt = static_cast<int>(index);
      Wire.persistent = persistent;
      const bool result = operation();
      if (result == persistent) {
        std::fprintf(stderr, "Unexpected result at transfer %zu reg=%02x kind=%d persistent=%d\n",
                     index, sequence[index].reg, sequence[index].kind, persistent);
        assert(false);
      }
      assert(Wire.faultStarted);
      assert(Wire.endCount >= 1);
      assertBounded();
    }
  }
}

void faultEveryQueuedByte(bool (*operation)()) {
  reset();
  assert(operation());
  const int queued = Wire.queueCalls;
  for (int index = 0; index < queued; ++index) {
    for (bool persistent : {false, true}) {
      reset();
      Wire.failQueueAt = index;
      Wire.persistentQueueFailure = persistent;
      assert(operation() == !persistent);
      assert(Wire.endCount == 1);
      assertBounded();
    }
  }
}
} // namespace

WireMock Wire;

void pinMode(uint8_t pin, uint8_t mode) {
  if (pin == SCL && gpio.modes[pin] == OUTPUT && mode != OUTPUT &&
      gpio.levels[pin] == LOW) {
    ++gpio.clocks;
  }
  gpio.modes[pin] = mode;
  if ((pin == SDA || pin == SCL) && mode == OUTPUT && gpio.levels[pin] == HIGH)
    gpio.droveHigh = true;
}

void digitalWrite(uint8_t pin, uint8_t value) {
  gpio.levels[pin] = value;
  if ((pin == SDA || pin == SCL) && gpio.modes[pin] == OUTPUT && value == HIGH)
    gpio.droveHigh = true;
}

int digitalRead(uint8_t pin) {
  if (pin == INT) return gpio.intStuck ? LOW : HIGH;
  if (pin == SCL && gpio.sclStuck) return LOW;
  if (pin == SDA && gpio.sdaStuck &&
      (!gpio.releaseSdaAfterClocks || gpio.clocks < gpio.releaseSdaAfterClocks)) return LOW;
  if (gpio.modes[pin] == OUTPUT) return gpio.levels[pin];
  return HIGH;
}

void delay(unsigned long ms) { gpio.micros += 1000 * ms; }
void delayMicroseconds(unsigned int us) { gpio.micros += us; }
unsigned long millis() { return gpio.micros / 1000; }

void WireMock::begin() { ++beginCount; }
void WireMock::end() { ++endCount; }
void WireMock::beginTransmission(uint8_t address) {
  assert(address == ADDRESS);
  tx.clear();
}
size_t WireMock::write(uint8_t value) {
  const int index = queueCalls++;
  if (index == failQueueAt || (persistentQueueFailure && failQueueAt >= 0 && index >= failQueueAt)) return 0;
  tx.push_back(value);
  return 1;
}

bool WireMock::record(Transfer transfer) {
  transfers.push_back(transfer);
  if (static_cast<int>(transfers.size()) - 1 == failAt) faultStarted = true;
  return faultStarted && (persistent || static_cast<int>(transfers.size()) - 1 == failAt);
}

uint8_t WireMock::endTransmission(bool) {
  if (tx.empty()) return record({Transfer::Write, 0, 0}) && fault == Nack ? 2 : 0;
  pointer = tx.front();
  const bool failed = record({tx.size() > 1 ? Transfer::Write : Transfer::ReadPointer,
                              pointer, tx.size() - 1});
  if (failed && fault == Nack) return 2;
  for (size_t i = 1; i < tx.size(); ++i) {
    const uint8_t reg = pointer + i - 1;
    if (reg == ignoredWriteReg) continue;
    // Status flags are write-zero-to-clear. EEbusy (bit 7) is read-only.
    if (reg == STATUS) {
      registers[reg] |= statusRaisedBeforeWrite;
      registers[reg] = (registers[reg] & tx[i]) | (registers[reg] & 0x80);
    }
    else registers[reg] = tx[i];
  }
  return 0;
}

uint8_t WireMock::requestFrom(uint8_t address, uint8_t size) {
  assert(address == ADDRESS);
  const bool failed = record({Transfer::Read, pointer, size});
  rx.clear();
  readIndex = 0;
  if (failed && fault == ShortRead) return 0;
  if (pointer == emptyReadBufferReg) return size;
  for (uint8_t i = 0; i < size; ++i) rx.push_back(registers[pointer + i]);
  return size;
}
int WireMock::available() { return static_cast<int>(rx.size() - readIndex); }
int WireMock::read() { return available() ? rx[readIndex++] : -1; }

struct BoardConfigContainer { bool probeRtc(); };
#include "probe.inc"

int main() {
  // Configure a working timer, including values outside the 12-bit range.
  for (uint16_t minutes : {uint16_t(0), uint16_t(1), uint16_t(60), uint16_t(4095), uint16_t(65535)}) {
    reset();
    assert(inhero::configurePeriodicWake(minutes));
    const uint16_t expected = minutes == 0 ? 1 : (minutes > 4095 ? 4095 : minutes);
    assert(Wire.registers[0x0a] == (expected & 0xff));
    assert((Wire.registers[0x0b] & 0x0f) == (expected >> 8));
    assert((Wire.registers[CTRL1] & 0x87) == 0x07); // TE=1, TRPT=0, TD=1/60 Hz
    assert((Wire.registers[CTRL1] & 0x08) != 0); // no daily EEPROM refresh
    assert((Wire.registers[CTRL2] & 0x7f) == 0x10); // exclusively TIE, no other interrupt
    assert((Wire.registers[CLKOUT] & 0x8f) == 0x07); // no CLKOUT or POR interrupt
    assert((Wire.registers[STATUS] & 0x08) == 0); // TF
    assert((Wire.registers[STATUS] & 0x01) != 0); // unrelated status preserved
    assert(Wire.endCount == 0);
  }

  // EEPROM-backed settings change in RAM without losing calibration/TCR.
  // EERD is intentionally set so a daily refresh cannot restore the old setup.
  // Init retains other control/interrupt settings; sleep selects only the timer.
  for (uint8_t eerd : {uint8_t(0), uint8_t(0x08)}) {
    reset();
    Wire.registers[CTRL1] |= eerd;
    assert(inhero::initializeRtc());
    assert(Wire.registers[CTRL1] == 0xa8);
    assert((Wire.registers[BACKUP] & 0x83) == 0x83); // OFFSET LSB and TCR
    assert((Wire.registers[BACKUP] & 0x7c) == 0x10); // FEDE, no BSM/TCE/BSIE
    assert(Wire.registers[CLKOUT] == 0x4f); // CLKSY/PORIE retained, clock disabled
    assert(Wire.registers[CTRL2] == 0x60);
    for (const auto& transfer : Wire.transfers)
      assert(transfer.kind != Transfer::Write || transfer.reg != 0x27); // no EEPROM command
  }

  faultEveryTransfer(configure);
  faultEveryTransfer(inhero::initializeRtc);
  faultEveryTransfer(inhero::clearTimerFlag);
  faultEveryQueuedByte(configure);
  faultEveryQueuedByte(inhero::initializeRtc);
  faultEveryQueuedByte(inhero::clearTimerFlag);

  reset();
  Wire.emptyReadBufferReg = BACKUP; // controller claims one byte, RX queue is empty
  assert(!configure());
  assertBounded();

  // ACK alone is insufficient: readback catches writes that do not persist.
  for (uint8_t reg : {BACKUP, CLKOUT, CTRL1, CTRL2, STATUS, uint8_t(0x0a), uint8_t(0x0b)}) {
    reset();
    Wire.ignoredWriteReg = reg;
    Wire.registers[0x0a] = 0xff;
    Wire.registers[0x0b] = 0x0f;
    assert(!inhero::configurePeriodicWake(60));
    assertBounded();
  }

  reset();
  gpio.intStuck = true;
  assert(!configure());
  assertBounded();

  reset();
  Wire.registers[STATUS] |= 0x80; // EEPROM controller never becomes ready.
  assert(!inhero::initializeRtc());
  assertBounded(420); // two attempts, each with EERD setup + 101 status polls

  reset();
  assert(inhero::clearTimerFlag());
  assert(Wire.registers[STATUS] == 0x01);
  Wire.ignoredWriteReg = STATUS;
  Wire.registers[STATUS] = 0x09;
  assert(!inhero::clearTimerFlag());
  assertBounded();

  reset();
  Wire.statusRaisedBeforeWrite = 0x20; // event arrives between reading and clearing TF
  assert(inhero::clearTimerFlag());
  assert(Wire.registers[STATUS] == 0x21);

  // Self-test restores user RAM after failed pattern transfers and verifies
  // both the patterns and the restoration. A failed restore cannot report OK.
  BoardConfigContainer config;
  reset();
  Wire.registers[0x1f] = 0x42;
  assert(config.probeRtc());
  assert(Wire.registers[0x1f] == 0x42);
  const auto probeSequence = Wire.transfers;
  size_t restoreIndex = 0;
  for (size_t index = 0; index < probeSequence.size(); ++index)
    if (probeSequence[index].kind == Transfer::Write && probeSequence[index].reg == 0x1f)
      restoreIndex = index;
  for (size_t index = 0; index < probeSequence.size(); ++index) {
    reset();
    Wire.registers[0x1f] = 0x42;
    Wire.fault = probeSequence[index].kind == Transfer::Read ? WireMock::ShortRead : WireMock::Nack;
    Wire.failAt = static_cast<int>(index);
    assert(!config.probeRtc());
    if (index != restoreIndex) assert(Wire.registers[0x1f] == 0x42);
  }
  reset();
  Wire.registers[0x1f] = 0x42;
  Wire.ignoredWriteReg = 0x1f;
  assert(!config.probeRtc());
  assert(Wire.registers[0x1f] == 0x42);

  // Recovery never actively drives a shared bus line HIGH, releases both pins,
  // and stops after bounded clocks/time even if a slave holds SCL/SDA LOW.
  for (unsigned releaseAfter : {0u, 1u, 9u}) {
    reset();
    gpio.sdaStuck = true;
    gpio.releaseSdaAfterClocks = releaseAfter;
    assert(inhero::recoverI2cBus(SDA, SCL) == (releaseAfter != 0));
    assert(gpio.clocks <= 10); // nine recovery clocks plus STOP clock
    assert(!gpio.droveHigh);
    assert(gpio.modes[SDA] != OUTPUT && gpio.modes[SCL] != OUTPUT);
    assertBounded();
  }
  reset();
  gpio.sclStuck = true;
  assert(!inhero::recoverI2cBus(SDA, SCL));
  assert(!gpio.droveHigh);
  assert(gpio.modes[SDA] != OUTPUT && gpio.modes[SCL] != OUTPUT);
  assertBounded();

  // A bus already held LOW never enters the Wire driver. Bus recovery still
  // restarts Wire so unrelated code is not left with an uninitialized bus.
  for (bool stuckScl : {false, true}) {
    reset();
    gpio.sclStuck = stuckScl;
    gpio.sdaStuck = !stuckScl;
    assert(!configure());
    assert(Wire.transfers.empty());
    assert(Wire.endCount == 1 && Wire.beginCount == 1);
    assertBounded();
  }
  reset();
  gpio.sdaStuck = true;
  gpio.releaseSdaAfterClocks = 3;
  assert(configure());
  assert(Wire.endCount == 1 && Wire.beginCount == 1);

  puts("PASS: MR2 RTC init/wake/TF/probe, every transfer/queue failure and retry, readback, stuck INT, bounded open-drain I2C recovery");
}
