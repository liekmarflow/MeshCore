// The runner inserts the actual board methods and constants from production.
// Mock side effects let tests observe both aborted and completed shutdowns.
#include <algorithm>
#include <cassert>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <string>
#include <vector>

@CONSTANTS@

#define PIN_BOARD_SDA 13
#define PIN_BOARD_SCL 14
#define PIN_LED1 35
#define PIN_LED2 36
#define LED_BLUE PIN_LED2
#define BQ_CE_PIN 6
#define INA_ALERT_PIN 7
#define GPIO_PIN_CNF_DIR_Input 0
#define GPIO_PIN_CNF_DIR_Pos 0
#define GPIO_PIN_CNF_INPUT_Connect 0
#define GPIO_PIN_CNF_INPUT_Pos 1
#define GPIO_PIN_CNF_PULL_Pullup 3
#define GPIO_PIN_CNF_PULL_Pos 2
#define GPIO_PIN_CNF_DRIVE_S0S1 0
#define GPIO_PIN_CNF_DRIVE_Pos 8
#define GPIO_PIN_CNF_SENSE_Low 3
#define GPIO_PIN_CNF_SENSE_Pos 16
constexpr int LOW = 0, HIGH = 1, INPUT = 0, OUTPUT = 1, INPUT_PULLUP = 2, FALLING = 1;

struct State {
  bool rtcOk = false;
  bool knownBattery = true;
  bool chargeFault = false;
  bool chargeRecoveryOk = true;
  bool alert = false;
  uint16_t voltage = 2500;
  uint32_t now = 0;
  uint16_t configuredMinutes = 0;
  std::vector<std::string> events;
} state;

template<typename... Args> void log(const char*, Args...) {}
#define MESH_DEBUG_PRINTLN(...) log(__VA_ARGS__)
void event(const char* value) { state.events.push_back(value); }
unsigned count(const char* value) {
  return std::count(state.events.begin(), state.events.end(), value);
}
void pinMode(int, int) { event("pinMode"); }
void digitalWrite(int, int) { event("digitalWrite"); }
int digitalRead(int) { return state.alert ? LOW : HIGH; }
void delay(unsigned) {}
uint32_t millis() { return state.now; }
int digitalPinToInterrupt(int pin) { return pin; }
void attachInterrupt(int, void (*)(), int) {}

struct Registers {
  unsigned GPREGRET2 = 0;
  unsigned SYSTEMOFF = 0;
  unsigned LATCH = 0;
  unsigned PIN_CNF[64] = {};
} registers;
Registers* NRF_POWER = &registers;
Registers* NRF_GPIO = &registers;
Registers* NRF_P0 = &registers;
struct SystemOff {};
void sd_power_system_off() { event("systemOff"); throw SystemOff{}; }
void __WFE() { assert(false); }

struct WireStub {
  void setPins(int, int) {}
  void begin() { event("wireBegin"); }
  void end() { event("wireEnd"); }
  void beginTransmission(int) { event("i2cWrite"); }
  void write(int) {}
  int endTransmission(bool = true) { return 0; }
  void requestFrom(uint8_t, uint8_t) {}
  int available() { return 0; }
  int read() { return 0; }
} Wire;

struct Ina228Driver {
  static uint16_t readVBATDirect(WireStub*, int) { return state.voltage; }
  void enableAlert(bool, bool, bool) { event("inaAlert"); }
  void setUnderVoltageAlert(int) { event("inaUnderVoltage"); }
  void shutdown() { event("inaShutdown"); }
  uint16_t readVoltage_mV() { return state.voltage; }
  void clearAlert() { event("clearAlert"); }
} ina;

struct BoardConfigContainer {
  enum BatteryType { BAT_UNKNOWN, BAT_LIPO };
  struct BatteryProperties { bool charge_enable; };
  static const BatteryProperties* getBatteryProperties(BatteryType) {
    static BatteryProperties props{true};
    return &props;
  }
  BatteryType getBatteryType() { return state.knownBattery ? BAT_LIPO : BAT_UNKNOWN; }
  bool getMPPTEnabled() { return true; }
  bool hasChargeConfigurationFault() { return state.chargeFault; }
  bool recoverChargeConfiguration() {
    event("chargerRecover");
    if (!state.chargeRecoveryOk) return false;
    state.chargeFault = false;
    return true;
  }
  void begin() { event("boardBegin"); }
  bool getStationAltitude(float&) { return false; }
  void setLowVoltageRecovery() { event("lowVoltageRecovery"); }
  static void setSOCManually(float) {}
  static void setupWatchdog() { event("watchdog"); }
  static void setUsbConnected(bool) {}
  static void stopBackgroundTasks() { event("stopTasks"); }
  Ina228Driver* getIna228Driver() { return &ina; }
} boardConfig;

struct Sensors { void setBme280StationAltitude(float) {} } sensors;
struct NRF52BoardDCDC { static void begin() { event("baseBegin"); } };

namespace inhero {
bool recoverI2cBus(int, int) { event("recover"); return true; }
bool clearTimerFlag() { event("clearTF"); return state.rtcOk; }
bool configurePeriodicWake(uint16_t minutes) {
  event("rtc");
  state.configuredMinutes = minutes;
  return state.rtcOk;
}
void maintainSolarDuringLowVoltageWake(bool) { event("solar"); }
void prepareIcsForSystemOff() { event("icsOff"); }
void prepareRadioForSystemOff(bool = true) { event("radioOff"); }
void disconnectLeakyPullups() { event("pullupsOff"); }
bool isUsbPowered() { return false; }
}

struct InheroMr2Board {
  void begin();
  void initiateShutdown(uint8_t reason);
  bool configureRTCWake(uint32_t minutes);
  uint16_t getLowVoltageWakeThreshold() { return 3000; }
  uint16_t getLowVoltageSleepThreshold() { return 2700; }
  static void rtcInterruptHandler() {}
} board;

@METHODS@

void blinkRed(int, int, int, bool) { event("blink"); }
struct LowVoltageTick {
  uint16_t lowVoltageSleepMv = 2700;
  Ina228Driver* ina228DriverInstance = &ina;
  bool lowVoltageAlertFired = false;
  bool lowVoltageSleepAttempted = false;
  uint32_t lastLowVoltageMs = 0;
  uint32_t lastLowVoltageSleepAttemptMs = 0;
  bool leds_enabled = true;
  void run() {
@LOW_VOLTAGE_TICK@
  }
};

void reset() { state = State{}; registers = Registers{}; }

void assertStillOperating() {
  assert(count("systemOff") == 0);
  assert(count("stopTasks") == 0);
  assert(count("inaShutdown") == 0);
  assert(count("radioOff") == 0);
  assert(count("icsOff") == 0);
  assert(count("pullupsOff") == 0);
  assert(registers.SYSTEMOFF == 0);
}

int main() {
  // Runtime Low-V failure must return before any shutdown side effects.
  reset();
  registers.GPREGRET2 = 0xa0;
  board.initiateShutdown(SHUTDOWN_REASON_LOW_VOLTAGE);
  assertStillOperating();
  assert(count("rtc") == 1);
  assert(state.events.size() == count("rtc") + count("chargerRecover"));
  assert(registers.GPREGRET2 == 0xa0);

  // Cold Low-V boot and failed wake/resleep both finish normal initialization.
  for (bool wake : {false, true}) {
    reset();
    registers.GPREGRET2 = wake ? GPREGRET2_LOW_VOLTAGE_SLEEP | SHUTDOWN_REASON_LOW_VOLTAGE : 0;
    board.begin();
    assertStillOperating();
    assert(count("rtc") == 1);
    assert(count("boardBegin") == 1);
    assert(count("baseBegin") == 1);
    assert(count("watchdog") == 1);
    assert(registers.GPREGRET2 == 0);
  }

  // A retained charger-configuration fault bypasses both early sleep paths.
  // Full board initialization must repair the BQ before it may sleep again.
  for (bool wake : {false, true}) {
    reset();
    state.rtcOk = true;
    state.chargeFault = true;
    registers.GPREGRET2 = wake ? GPREGRET2_LOW_VOLTAGE_SLEEP | SHUTDOWN_REASON_LOW_VOLTAGE : 0;
    board.begin();
    assertStillOperating();
    assert(count("rtc") == 0);
    assert(count("boardBegin") == 1);
    assert(count("baseBegin") == 1);
    assert(count("watchdog") == 1);
    assert(registers.GPREGRET2 == 0);
  }

  // An RTC wake timer alone is insufficient after a charger setup fault.
  reset();
  state.rtcOk = true;
  state.chargeFault = true;
  state.chargeRecoveryOk = false;
  registers.GPREGRET2 = 0xa0;
  board.initiateShutdown(SHUTDOWN_REASON_LOW_VOLTAGE);
  assertStillOperating();
  assert(count("chargerRecover") == 1);
  assert(state.chargeFault);
  assert(registers.GPREGRET2 == 0xa0);

  // A successful checked recovery permits the ordinary runtime sleep path.
  reset();
  state.rtcOk = true;
  state.chargeFault = true;
  try { board.initiateShutdown(SHUTDOWN_REASON_LOW_VOLTAGE); assert(false); }
  catch (const SystemOff&) {}
  assert(!state.chargeFault);
  assert(count("chargerRecover") == 1);
  assert(count("systemOff") == 1);
  assert(std::find(state.events.begin(), state.events.end(), "chargerRecover") <
         std::find(state.events.begin(), state.events.end(), "stopTasks"));

  // All three Low-V entries still sleep when the RTC was armed successfully.
  for (int path : {0, 1, 2}) {
    reset();
    state.rtcOk = true;
    if (path == 1) registers.GPREGRET2 = GPREGRET2_LOW_VOLTAGE_SLEEP | SHUTDOWN_REASON_LOW_VOLTAGE;
    try {
      if (path == 2) board.initiateShutdown(SHUTDOWN_REASON_LOW_VOLTAGE);
      else board.begin();
      assert(false);
    } catch (const SystemOff&) {}
    assert(count("rtc") == 1);
    assert(count("radioOff") == 1);
    assert(count("systemOff") == 1);
    assert(registers.GPREGRET2 == (GPREGRET2_LOW_VOLTAGE_SLEEP | SHUTDOWN_REASON_LOW_VOLTAGE));
    assert(std::find(state.events.begin(), state.events.end(), "rtc") <
           std::find(state.events.begin(), state.events.end(), "radioOff"));
  }

  // Explicit user/thermal shutdown does not depend on the Low-V wake source.
  for (uint8_t reason : {SHUTDOWN_REASON_USER_REQUEST, SHUTDOWN_REASON_THERMAL}) {
    reset();
    try { board.initiateShutdown(reason); assert(false); }
    catch (const SystemOff&) {}
    assert(count("rtc") == 0);
    assert(count("systemOff") == 1);
    assert(registers.GPREGRET2 == reason);
  }

  // Recovered voltage avoids sleep even if RTC communication is unavailable.
  reset();
  state.voltage = 3100;
  registers.GPREGRET2 = GPREGRET2_LOW_VOLTAGE_SLEEP | SHUTDOWN_REASON_LOW_VOLTAGE;
  board.begin();
  assertStillOperating();
  assert(count("rtc") == 0);
  assert(count("boardBegin") == 1);

  reset();
  assert(!board.configureRTCWake(0));
  assert(state.configuredMinutes == LOW_VOLTAGE_SLEEP_MINUTES);
  assert(!board.configureRTCWake(65536));
  assert(state.configuredMinutes == 4095);
  state.rtcOk = true;
  assert(board.configureRTCWake(12));
  assert(state.configuredMinutes == 12);

  // A failed runtime attempt clears the stale trip and retries at most once
  // per minute, including across the millis() uint32_t rollover.
  for (uint32_t first : {uint32_t(1000), UINT32_MAX - 10000u}) {
    reset();
    LowVoltageTick tick;
    state.alert = true;
    state.now = first;
    tick.run();
    assert(count("rtc") == 1);
    assert(!tick.lowVoltageAlertFired);
    assert(count("clearAlert") == 1);
    for (uint32_t elapsed : {1u, 1000u, 59999u}) {
      state.now = first + elapsed;
      tick.run();
      assert(count("rtc") == 1);
    }
    state.now = first + 60000u;
    tick.run();
    assert(count("rtc") == 2);
    assertStillOperating();
    assert(registers.GPREGRET2 == 0);

    state.alert = false;
    state.voltage = 3100;
    state.now = first + 120000u;
    tick.run();
    assert(count("rtc") == 2); // cleared stale trip cannot trigger another try
  }

  // An alert received during the cooldown must be rechecked when due: the
  // voltage may have recovered in the meantime, but a zero read is not proof.
  for (uint16_t voltageAtRetry : {uint16_t(0), uint16_t(3100)}) {
    reset();
    LowVoltageTick tick;
    state.alert = true;
    state.now = 1000;
    tick.run();
    state.now = 2000;
    tick.run();
    assert(tick.lowVoltageAlertFired);
    state.alert = false;
    state.voltage = voltageAtRetry;
    state.now = 61000;
    tick.run();
    assert(count("rtc") == (voltageAtRetry == 0 ? 2 : 1));
    assert(!tick.lowVoltageAlertFired);
    assertStillOperating();
  }

  puts("PASS: all three Low-V sleep gates, retained charger-fault interlock and recovery, abort before side effects, successful/user/thermal shutdown, retry cooldown and rollover");
}
